# Copie para .env e ajuste. Em produção, configure estas variáveis no Render.
ENVIRONMENT=development
# Aceita também a "Service URI" do Aiven como está (mysql://...?ssl-mode=REQUIRED)
DATABASE_URL=mysql+pymysql://eventmer:eventmer@localhost:3306/eventmer?charset=utf8mb4
# Conteúdo do certificado CA do banco (Aiven: "CA certificate"). Vazio em desenvolvimento.
DATABASE_SSL_CA=

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo
QR_SECRET=troque-este-segredo-tambem

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Criados automaticamente no primeiro deploy (python -m app.cli bootstrap)
ORGANIZATION_NAME=Igreja
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Origens do frontend permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# E-mail: console (só log) | gmail_api (produção, funciona no Render gratuito) | smtp
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CANTEMOS 2026
EMAIL_REPLY_TO=
# gmail_api — ver docs/06-hospedagem-gratuita.md
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# smtp — Gmail com senha de app (não funciona no Render gratuito)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
